# Copie para .env e ajuste os valores conforme o ambiente local.
NODE_ENV=development
PORT=3001
# URL do Postgres em desenvolvimento (usada quando NODE_ENV != "production").
DATABASE_URL_LOCAL=postgres://quinto_set:quinto_set@localhost:5433/quinto_set
# URL do Postgres em produção (usada quando NODE_ENV = "production").
DATABASE_URL_PROD=postgres://quinto_set:quinto_set@localhost:5433/quinto_set
# Override: se definida, DATABASE_URL tem prioridade sobre as duas acima
# (ex.: quando a plataforma de deploy injeta a connection string diretamente).
# DATABASE_URL=postgres://...
# "postgres" (default) persiste no banco; "memory" usa o repositório em memória.
STORAGE=postgres
LOG_LEVEL=info
# "*" libera qualquer origem (default). Separe com vírgula para restringir.
CORS_ORIGIN=*
# Segredo usado para assinar o token de sessão do admin. Em produção, use um valor forte.
AUTH_SECRET=change-me-in-production
# Credenciais do admin usadas pelo seed (npm run db:seed). Mude antes de rodar o seed.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Tempo de vida do token de sessão em segundos (default: 7 dias).
AUTH_TOKEN_TTL=604800
