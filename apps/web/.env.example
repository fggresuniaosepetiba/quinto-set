# URL base da API (server-side, usada pelos route handlers do BFF).
# Em dev, a API roda em http://localhost:3001 (default).
# Em produção, defina a URL privada da API (ex.: https://api.quintoset.com.br).
API_URL=http://localhost:3001

# URL base da API para chamadas diretas do browser (forms públicos).
# Em dev, a API roda em http://localhost:3001 (default).
# Em produção, defina a URL pública da API (ex.: https://api.quintoset.com.br).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Sessão do painel admin (dados sensíveis).
# ADMIN_IDLE_TIMEOUT_MINUTES: minutos sem atividade até deslogar (default 15).
# NEXT_PUBLIC_ADMIN_IDLE_TIMEOUT_MINUTES deve ter o mesmo valor para o aviso no browser.
# ADMIN_IDLE_WARNING_MINUTES: minutos antes do logout para mostrar aviso (default 2).
ADMIN_IDLE_TIMEOUT_MINUTES=15
NEXT_PUBLIC_ADMIN_IDLE_TIMEOUT_MINUTES=15
ADMIN_IDLE_WARNING_MINUTES=2
NEXT_PUBLIC_ADMIN_IDLE_WARNING_MINUTES=2