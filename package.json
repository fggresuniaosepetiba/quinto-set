{
  "name": "quinto-set",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @quinto-set/web",
    "dev:api": "npm run dev --workspace @quinto-set/api",
    "build": "npm run build --workspace @quinto-set/web",
    "start": "npm run start --workspace @quinto-set/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
